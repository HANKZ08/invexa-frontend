# Copia este archivo como .env.local y ajusta los valores.

# URL base de la API. Vacío = mismo origen (/api), usando el proxy de Vite en desarrollo.
# En producción apunta al backend, por ejemplo: https://api.invexa.example
VITE_API_URL=

# Backend al que el proxy de Vite reenvía /api en desarrollo.
VITE_API_PROXY_TARGET=http://localhost:3000
